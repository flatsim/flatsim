<?xml version="1.0"?>
<robot name="tractor">
  <flatsim>
    <color rgba="0 255 100 255"/>
    <turning radius="2.4"/>
  </flatsim>

  <!-- Base footprint: virtual link at ground level -->
  <link name="base_footprint"/>

  <!-- Base link: robot origin at center of wheel axis -->
  <link name="base_link"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.7" rpy="0 0 0"/>
  </joint>

  <!-- Sensor tree root -->
  <link name="sensor_link"/>
  <joint name="sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gnss_link">
    <sensor name="GNSS" type="gnss">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </sensor>
  </link>
  <joint name="gnss_joint" type="fixed">
    <parent link="sensor_link"/>
    <child link="gnss_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <sensor name="IMU" type="imu">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </sensor>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="sensor_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <sensor name="LIDAR" type="lidar">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <flatsim/>
    </sensor>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Body karosserie (defines machine bounds) -->
  <link name="body_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.6 2.8 0.3"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.6 2.8 0.3"/>
      </geometry>
    </collision>
  </link>
  <joint name="body_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <flatsim karosserie_name="body" karosserie_sections="0" karosserie_has_physics="true"/>
  </joint>

  <!-- Chassis parts (karosseries) -->
  <link name="front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.14 0.3"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.14 0.3"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="front_link"/>
    <origin xyz="0 1.47 0" rpy="0 0 0"/>
    <flatsim karosserie_name="front" karosserie_sections="0" karosserie_has_physics="true"/>
  </joint>

  <link name="hitch_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.28 0.3"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.28 0.3"/>
      </geometry>
    </collision>
  </link>
  <joint name="hitch_mount_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="hitch_mount_link"/>
    <origin xyz="0 -1.47 0" rpy="0 0 0"/>
    <flatsim karosserie_name="hitch_mount" karosserie_sections="0" karosserie_has_physics="false"/>
  </joint>

  <!-- Hitch geometry (hitches/rear_hitch) -->
  <link name="rear_hitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.3"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.3"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_hitch_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="rear_hitch_link"/>
    <origin xyz="0 -1.47 0" rpy="0 0 0"/>
    <flatsim hitch_name="rear_hitch" hitch_is_master="true"/>
  </joint>

  <!-- Wheels: Ackermann-like (front steering joints + wheel spin) -->

  <!-- Front right -->
  <link name="front_right_steer_link"/>
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.8 0.84 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6108652382" upper="0.6108652382" effort="0" velocity="0"/>
    <flatsim steering_max="35" steering_diff="-4"/>
  </joint>
  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.42" length="0.352"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.42" length="0.352"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <flatsim side="right" throttle_max="0.0" throttle_diff="0" steering_max="35" steering_diff="-4"/>
  </joint>

  <!-- Front left -->
  <link name="front_left_steer_link"/>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="-0.8 0.84 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6108652382" upper="0.6108652382" effort="0" velocity="0"/>
    <flatsim steering_max="35" steering_diff="4"/>
  </joint>
  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.42" length="0.352"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.42" length="0.352"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <flatsim side="left" throttle_max="0.0" throttle_diff="0" steering_max="35" steering_diff="4"/>
  </joint>

  <!-- Rear right -->
  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.7" length="0.64"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.7" length="0.64"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0.8 -0.84 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <flatsim side="right" throttle_max="0.2" throttle_diff="0" steering_max="0" steering_diff="0"/>
  </joint>

  <!-- Rear left -->
  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.7" length="0.64"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.7" length="0.64"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.8 -0.84 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <flatsim side="left" throttle_max="0.2" throttle_diff="0" steering_max="0" steering_diff="0"/>
  </joint>

  <!-- Power: represent tank geometry and store parameters as tags -->
  <link name="fuel_tank_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.5 0.3"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.5 0.3"/>
      </geometry>
    </collision>
  </link>
  <joint name="fuel_tank_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="fuel_tank_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <flatsim power_name="fuel_tank" power_type="FUEL" power_capacity="150" power_consumption_rate="0.03" power_charge_rate="0"/>
  </joint>

</robot>
