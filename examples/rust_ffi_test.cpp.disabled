// Simple FFI test to verify Rust integration works
// To build and run: cmake -B build -DFLATSIM_BUILD_EXAMPLES=ON -DFLATSIM_ENABLE_RUST=ON && cmake --build build && ./build/rust_ffi_test

#include <iostream>

// Include CXX bridge headers (generated by build)
// These will be available after first build
#include "rust/cxx.h"
#include "flatsim-ffi/src/lib.rs.h"

int main() {
    std::cout << "=== Flatsim Rust FFI Test ===" << std::endl;
    
    // Test basic FFI call
    rust::String message = rust_hello();
    std::cout << "Rust says: " << message << std::endl;
    
    // Test Vec2 operations
    double length = vec2_example(3.0, 4.0);
    std::cout << "Length of Vec2(3.0, 4.0) = " << length << std::endl;
    
    if (length == 5.0) {
        std::cout << "✓ FFI working correctly!" << std::endl;
        return 0;
    } else {
        std::cerr << "✗ FFI test failed!" << std::endl;
        return 1;
    }
}
